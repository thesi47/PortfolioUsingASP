@{
}
@model PortfolioUsingASP.Models.Education

@{
    ViewData["Title"] = "Delete Education";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-danger">Delete Education</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <h5>Are you sure you want to delete this record?</h5>

        <dl class="row mt-3">
            <dt class="col-sm-3">Level</dt>
            <dd class="col-sm-9">@Model.EduLevel</dd>

            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@Model.SubjectOrGroup</dd>

            <dt class="col-sm-3">Result</dt>
            <dd class="col-sm-9">@Model.Result</dd>

            <dt class="col-sm-3">Year</dt>
            <dd class="col-sm-9">@Model.PassingYear</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="EduId" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>

    </div>
</div>