@{
}
@model List<PortfolioUsingASP.Models.Experience>

@{
    ViewData["Title"] = "Experience";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Experience</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Add Experience</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Job Title</th>
                    <th>Company</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.JobTitle</td>
                        <td>@item.CompanyName</td>
                        <td>@item.StartDate</td>
                        <td>@item.EndDate</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.JobId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.JobId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>