@{
}
@model PortfolioUsingASP.Models.Experience

@{
    ViewData["Title"] = "Edit Experience";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit Experience</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <form asp-action="Edit" method="post" class="row g-3">

            <input type="hidden" asp-for="JobId" />

            <div class="col-md-6">
                <label asp-for="JobTitle" class="form-label"></label>
                <input asp-for="JobTitle" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label"></label>
                <input asp-for="CompanyName" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="JobDescription" class="form-label"></label>
                <textarea asp-for="JobDescription" class="form-control"></textarea>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success">Update</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>

        </form>

    </div>
</div>