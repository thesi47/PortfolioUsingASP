<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Portfolio</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">MyPortfolio</a>

            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Skills" asp-action="Index">Skills</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Project" asp-action="Index">Projects</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Experience" asp-action="Index">Experience</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Education" asp-action="Index">Education</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>


    <footer class="bg-dark text-white text-center p-3 mt-5">
        <p>© 2026 My Portfolio | Built with ASP.NET MVC</p>
    </footer>

</body>
</html>
