@{
}
@model PortfolioUsingASP.Models.Skills

@{
    ViewData["Title"] = "Delete Skill";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 text-danger">Delete Skill</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to list</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <h5>Are you sure you want to delete this skill?</h5>

        <dl class="row mt-3">
            <dt class="col-sm-3">Skill Name</dt>
            <dd class="col-sm-9">@Model.SkillName</dd>

            <dt class="col-sm-3">Skill Level</dt>
            <dd class="col-sm-9">@Model.SkillLevel</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="SkillId" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>

    </div>
</div>